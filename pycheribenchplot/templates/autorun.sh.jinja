#!/bin/sh

set -e

usage() {
    echo "Run session across multiple targets on this machine"
    echo "-s Prepare the machine for autorun"
    echo "-t Cleaup the autorun init.d"
    echo "-n Do not trigger reboot"
    echo "-k <time> Use custom settle time, defaults to {{ autorun_common.settle_delay }} seconds"
    echo "Usage: $0"
}

OPT_RC_SETUP=
OPT_RC_TEARDOWN=
OPT_NOREBOOT=

SESSION_WORKDIR="$(pwd)"
AUTORUN_PATH="${SESSION_WORKDIR}/$(basename '$0')"
AUTORUN_RC="/usr/local/etc/rc.d/benchplot"
SETTLE_TIME={{ autorun_common.settle_delay }}

HAS_BOOTENV="$(which bectl 2>/dev/null || true)"

while [ "$#" -gt 0 ]; do
    case $1 in
        -h)
            usage
            exit
            ;;
        -s)
            OPT_RC_SETUP=1
            ;;
        -t)
            OPT_RC_TEARDOWN=1
            ;;
        -n)
            OPT_NOREBOOT=1
            ;;
        -k)
            if [ -n "$2" ]; then
                SETTLE_TIME=$2
                shift
            else
                usage
                exit
            fi
            ;;
        *)
            usage
            exit
            ;;
    esac

    shift
done

ARCH="$(uname -m)"
KERNEL="$(uname -i)"
if [ -n "${HAS_BOOTENV}" ]; then
    ACTIVE_BE="$(bectl list -H | grep -E '[^[:blank:]]+\s+NR?T?' | cut -f1)"
    REBOOT_BE="$(bectl list -H | grep -E '[^[:blank:]]+\s+N?RT?' | cut -f1)"
fi

echo "##############################################"
echo "Benchplot auto-run: $0"
echo "User: $(whoami)"
echo "Workdir: ${SESSION_WORKDIR}"
echo "Settle time: ${SETTLE_TIME}"
echo "Arch: ${ARCH}"
echo "Kernel: ${KERNEL}"
echo "Bootenv: ${ACTIVE_BE}"
echo "##############################################"

# boot_kernel <bootenv> <kernel_name>
boot_kernel() {
    local bootenv="${1}"
    local kconf="${2}"
    local kdir=""

    if [ -n "${HAS_BOOTENV}" ]; then
        if [ -z "${bootenv}" ]; then
            echo "Using default bootenv ${REBOOT_BE}"
        elif [ "${bootenv}" = "${REBOOT_BE}" ]; then
            echo "Already rebooting into target bootenv ${bootenv}, skip activate"
        else
            echo "Activate target bootenv ${bootenv}"
            bectl activate -t "${bootenv}"
        fi

        if [ -n "${bootenv}" ] && [ "${bootenv}" != "${ACTIVE_BE}" ]; then
            mkdir -p /tmp/be_mount
            bectl mount "${bootenv}" /tmp/be_mount > /dev/null
            if [ -d "/tmp/be_mount/boot/kernel.${kconf}" ]; then
                kdir="kernel.${kconf}"
            elif [ -d "/tmp/be_mount/boot/kernel" ]; then
                kdir="kernel"
            else
                echo "ERROR: neither /boot/kernel.${kconf} nor /boot/kernel found in bootenv ${bootenv}"
                bectl umount "${bootenv}"
                rmdir /tmp/be_mount
                exit 1
            fi
            echo "Update next boot kernel to ${kdir} (${kconf})"
            echo "kernel=\"${kdir}\"" > /tmp/be_mount/boot/nextboot.conf
            bectl umount "${bootenv}"
            rmdir /tmp/be_mount
            # Ensure that the next boot will look for /boot/nextboot.conf
            zfsbootcfg -z zroot -n "freebsd:nvstore" -k "nextboot_enable" -v "YES"
        else
            if [ -d "/boot/kernel.${kconf}" ]; then
                kdir="kernel.${kconf}"
            else
                kdir="kernel"
            fi
            echo "Update next boot kernel to ${kdir} (${kconf})"
            nextboot {% if single_user %}-o "-s"{% endif %} -k "${kdir}"
        fi
    else
        if [ -n "${bootenv}" ]; then
            echo "WARNING: this configuration uses boot environments."
            echo "If this is intentional, use autorun.sh -n to disable auto reboot."
            exit 1
        fi
        if [ -d "/boot/kernel.${kconf}" ]; then
            kdir="kernel.${kconf}"
        else
            kdir="kernel"
        fi
        echo "Update next boot kernel to ${kdir} (${kconf})"
        nextboot {% if single_user %}-o "-s"{% endif %} -k "${kdir}"
    fi
}

setup_rc_conf() {
    local bootenv="$1"
    local root_prefix=""
    local rc_service="${AUTORUN_RC}"
    local rc_conf_dir="/etc/rc.conf.d"
    local rc_conf_file="/etc/rc.conf.d/benchplot"

    echo "Install autorun rc hook..."
    if [ -n "${bootenv}" ] && [ "${bootenv}" != "${ACTIVE_BE}" ]; then
        echo "Enter bootenv ${bootenv}"
        bectl mount "${bootenv}" /tmp/be_mount > /dev/null
        root_prefix="/tmp/be_mount"
        rc_service="${root_prefix}${AUTORUN_RC}"
        rc_conf_dir="${root_prefix}/etc/rc.conf.d"
        rc_conf_file="${rc_conf_dir}/benchplot"
    fi

    mkdir -p "$(dirname "${rc_service}")"
    mkdir -p "${rc_conf_dir}"
    cp "${SESSION_WORKDIR}/rc-autorun.sh" "${rc_service}"
    sysrc -f "${rc_conf_file}" benchplot_enable="YES"
    sysrc -f "${rc_conf_file}" benchplot_session="${SESSION_WORKDIR}"
    sysrc -f "${rc_conf_file}" benchplot_user="{{ autorun_common.user }}"
    sysrc -f "${rc_conf_file}" benchplot_reboot="{{ 'YES' if autorun_common.reboot else 'NO' }}"
    sysrc -f "${rc_conf_file}" benchplot_settle_delay="{{ autorun_common.settle_delay }}"

    if [ -n "${bootenv}" ] && [ "${bootenv}" != "${ACTIVE_BE}" ]; then
        bectl umount "${bootenv}"
        echo "Exited bootenv ${bootenv}"
    fi
    echo "Done"
}

teardown_rc_conf() {
    local bootenv="$1"
    local rc_service="${AUTORUN_RC}"
    local rc_conf_file="/etc/rc.conf.d/benchplot"

    echo "Teardown autorun rc hook..."
    if [ -n "${bootenv}" ] && [ "${bootenv}" != "${ACTIVE_BE}" ]; then
        echo "Enter bootenv ${bootenv}"
        bectl mount "${bootenv}" /tmp/be_mount > /dev/null
        rc_service="/tmp/be_mount${AUTORUN_RC}"
        rc_conf_file="/tmp/be_mount/etc/rc.conf.d/benchplot"
    fi

    if [ -f "${rc_service}" ]; then
        echo "Teardown autorun service ${rc_service}"
        rm "${rc_service}"
    fi
    if [ -f "${rc_conf_file}" ]; then
        sysrc -f "${rc_conf_file}" -x benchplot_enable || true
        sysrc -f "${rc_conf_file}" -x benchplot_session || true
        sysrc -f "${rc_conf_file}" -x benchplot_user || true
        sysrc -f "${rc_conf_file}" -x benchplot_reboot || true
        sysrc -f "${rc_conf_file}" -x benchplot_settle_delay || true
    fi

    if [ -n "${bootenv}" ] && [ "${bootenv}" != "${ACTIVE_BE}" ]; then
        bectl umount "${bootenv}"
        echo "Exited bootenv ${bootenv}"
    fi
}

if [ -n "${OPT_RC_SETUP}" ]; then
    if [ -z "${HAS_BOOTENV}" ]; then
        # Install rc hook for the current system, skip bootenv handling
        setup_rc_conf
    fi

    # Clear / create autorun logfile
    # Note that if sbin/daemon finds it here, it will retain the
    # current permission
    truncate -s 0 "${SESSION_WORKDIR}/auto-run.log"
    chmod 644 "${SESSION_WORKDIR}/auto-run.log"

    echo "Prepare kernel to boot..."
    NEXT_KERNEL=""
    NEXT_BE=""
    {% for info in autorun_targets %}
    {% if info.autorun.arch %}
    if [ -z "${NEXT_KERNEL}" ] && [ "${ARCH}" = "{{ info.autorun.arch }}" ]; then
        NEXT_KERNEL="{{ info.autorun.kernel }}"
        NEXT_BE="{{ info.autorun.bootenv or '' }}"
    fi
    {% else %}
    if [ -z "${NEXT_KERNEL}" ]; then
        NEXT_KERNEL="{{ info.autorun.kernel }}"
        NEXT_BE="{{ info.autorun.bootenv or '' }}"
    fi
    {% endif %}
    {% endfor %}

    if [ -z "${NEXT_KERNEL}" ]; then
        echo "Unexpected architecture ${ARCH}"
        exit 1
    fi

    if [ -n "${HAS_BOOTENV}" ]; then
        {% set bootenvs = autorun_targets | map(attribute='autorun.bootenv') | reject('none') | unique | list %}
        {% if bootenvs | length == 0 %}
        echo "Install autorun rc hook for default bootenv ${ACTIVE_BE}"
        setup_rc_conf
        {% else %}
        mkdir -p /tmp/be_mount
        {% for bootenv in bootenvs %}
        setup_rc_conf "{{ bootenv }}"
        {% endfor %}
        rmdir /tmp/be_mount
        {% endif %}
    fi

    boot_kernel "${NEXT_BE}" "${NEXT_KERNEL}"
    echo "Done -- Reboot now to trigger auto-run sequence"
    exit 0
fi

if [ -n "${OPT_RC_TEARDOWN}" ]; then
    echo "Teardown autorun rc hooks..."
    if [ -n "${HAS_BOOTENV}" ]; then
        # Attempt to de-register autorun from all bootenvs
        mkdir -p /tmp/be_mount
        for bootenv in $(bectl list -H | cut -w -f1); do
            teardown_rc_conf "${bootenv}"
        done
        rmdir /tmp/be_mount
    else
        teardown_rc_conf
    fi
    echo "Done"
    exit 0
fi

# Determine current workload run script and next kernel to boot
FOUND_CURRENT=""
WORKLOAD_SCRIPT=""
NEXT_KERNEL=""
NEXT_BE=""

{% for info in autorun_targets %}
{% if info.autorun.arch %}
if [ "${ARCH}" = "{{ info.autorun.arch }}" ]; then
    if [ -n "${FOUND_CURRENT}" ] && [ -z "${NEXT_KERNEL}" ]; then
        NEXT_KERNEL="{{ info.autorun.kernel }}"
        NEXT_BE="{{ info.autorun.bootenv or '' }}"
    elif [ -z "${FOUND_CURRENT}" ] && [ "${KERNEL}" = "{{ info.autorun.kernel }}" ]; then
        FOUND_CURRENT=1
        WORKLOAD_SCRIPT="{{ info.run_script }}"
    fi
fi
{% else %}
if [ -n "${FOUND_CURRENT}" ] && [ -z "${NEXT_KERNEL}" ]; then
    NEXT_KERNEL="{{ info.autorun.kernel }}"
    NEXT_BE="{{ info.autorun.bootenv or '' }}"
elif [ -z "${FOUND_CURRENT}" ] && [ "${KERNEL}" = "{{ info.autorun.kernel }}" ]; then
    FOUND_CURRENT=1
    WORKLOAD_SCRIPT="{{ info.run_script }}"
fi
{% endif %}
{% endfor %}

if [ -z "${FOUND_CURRENT}" ]; then
    echo "Unexpected arch/kernel encountered: arch=${ARCH} kernel=${KERNEL}"
    exit 1
fi

if [ -n "${WORKLOAD_SCRIPT}" ]; then
    echo "Auto-run sequence ({{ session }}): workload ${WORKLOAD_SCRIPT}"
    echo "Waiting for system to settle"
    sleep "${SETTLE_TIME}"
    echo "Run!"
    "${SESSION_WORKDIR}/${WORKLOAD_SCRIPT}"
fi

if [ -n "${NEXT_KERNEL}" ] && [ -z "${OPT_NOREBOOT}" ]; then
    echo "Prepare kernel to boot..."
    boot_kernel "${NEXT_BE}" "${NEXT_KERNEL}"
    echo "Reboot now!"
    reboot
fi
